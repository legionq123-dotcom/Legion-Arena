# Local development only. Replace credentials for any shared/deployed environment.
DATABASE_URL=postgres://legion:legion_dev_only@127.0.0.1:5432/legion_arena
REDIS_URL=redis://127.0.0.1:6379
REGION_ID=local
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
# Set PGSSLMODE=require for managed PostgreSQL that requires TLS.
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=true
REDIS_CACHE_TTL_SECONDS=30
HOST=127.0.0.1
PORT=8080
